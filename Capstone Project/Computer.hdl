// Computer.hdl - the complete Hack computer (Nand2Tetris Project 5)
// Author: Vansh Nibhoria (Roll No. 2501730240)
//
// ROM32K feeds instructions to the CPU; the CPU reads and writes data
// memory (RAM + screen + keyboard) through the Memory chip.

CHIP Computer {
    IN reset;

    PARTS:
    ROM32K(address=pc, out=instruction);

    CPU(inM=memOut, instruction=instruction, reset=reset,
        outM=outM, writeM=writeM, addressM=addressM, pc=pc);

    Memory(in=outM, load=writeM, address=addressM, out=memOut);
}
