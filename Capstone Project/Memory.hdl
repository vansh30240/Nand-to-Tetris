// Memory.hdl - Hack data memory (Nand2Tetris Project 5)
// Author: Vansh Nibhoria (Roll No. 2501730240)
//
// Memory map (15-bit address):
//   0     .. 16383 : RAM16K   (address[14]=0)
//   16384 .. 24575 : Screen   (address[14..13] = 10)
//   24576          : Keyboard (address[14..13] = 11)

CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    // Route the load signal using the top two address bits
    DMux4Way(in=load, sel=address[13..14], a=ramLoadA, b=ramLoadB, c=screenLoad);
    Or(a=ramLoadA, b=ramLoadB, out=ramLoad);

    RAM16K(in=in, load=ramLoad, address=address[0..13], out=ramOut);
    Screen(in=in, load=screenLoad, address=address[0..12], out=screenOut);
    Keyboard(out=kbdOut);

    // Select the output: 00 and 01 -> RAM, 10 -> Screen, 11 -> Keyboard
    Mux4Way16(a=ramOut, b=ramOut, c=screenOut, d=kbdOut, sel=address[13..14], out=out);
}
